{
  "name": "@rushdb/connectors",
  "version": "0.1.1",
  "description": "Connectors for RushDB: the spec format, an HTTP runtime, the built-in catalog of SaaS connectors, field doctrine (PII) tooling and rushdb-agent, the on-prem database agent.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rush-db/connectors.git"
  },
  "homepage": "https://github.com/rush-db/connectors#readme",
  "keywords": [
    "rushdb",
    "connectors",
    "etl",
    "integrations",
    "knowledge-graph",
    "clickhouse",
    "postgres",
    "mysql",
    "mongodb",
    "on-prem",
    "pii"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent.d.ts",
        "default": "./dist/agent.js"
      },
      "require": {
        "types": "./dist/agent.d.cts",
        "default": "./dist/agent.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "Dockerfile"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "build": "tsup",
    "logos": "node scripts/build-logos.mjs",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "bin": {
    "rushdb-agent": "dist/rushdb-agent.cjs"
  },
  "peerDependencies": {
    "pg": ">=8",
    "mysql2": ">=3",
    "mongodb": ">=6",
    "@clickhouse/client": ">=1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "@clickhouse/client": {
      "optional": true
    }
  }
}
